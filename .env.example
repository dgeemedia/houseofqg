NEXT_PUBLIC_SANITY_PROJECT_ID=
NEXT_PUBLIC_SANITY_DATASET=production
SANITY_API_TOKEN=            # Editor token (server only) - writes orders & stock
FLUTTERWAVE_SECRET_KEY=
FLUTTERWAVE_SUBACCOUNT_ID=   # House of QG subaccount (RS_xxxxxxxx) from Flutterwave > Settings > Subaccounts. Payments settle to it.
FLUTTERWAVE_SECRET_HASH=     # any long secret; same value in Flutterwave > Webhooks
NEXT_PUBLIC_SITE_URL=http://localhost:3000   # https://houseofqg.com in production
RESEND_API_KEY=              # resend.com: sends first (free 100/day). Domain houseofqg.com must be verified there
EMAIL_FROM=House of QG <orders@houseofqg.com>
OWNER_EMAIL=                 # you: new order / review alerts by email
TELEGRAM_BOT_TOKEN=          # optional instant phone alerts (create a bot with @BotFather)
TELEGRAM_CHAT_ID=
SANITY_WEBHOOK_SECRET=       # long random string; same value in the Sanity webhook URL
AUTO_REFUND=false            # true = cancelling a paid order refunds it via Flutterwave
NEXT_PUBLIC_GA_ID=           # optional Google Analytics 4 id (G-XXXX)
NEXT_PUBLIC_META_PIXEL_ID=   # optional Meta Pixel id
TELEGRAM_WEBHOOK_SECRET=     # long random string (letters/numbers); used when registering the Telegram webhook for live chat
TELEGRAM_POLL=false          # LOCAL TESTING ONLY: true lets live-chat replies work on localhost without a webhook (never set true in production)
AUTH_SECRET=                 # long random string (node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"): signs customer logins
AUTH_GOOGLE_ID=              # optional: Google sign-in (Google Cloud console > OAuth client)
AUTH_GOOGLE_SECRET=
AUTH_FACEBOOK_ID=            # optional: Facebook sign-in (developers.facebook.com app)
AUTH_FACEBOOK_SECRET=
BREVO_API_KEY=               # brevo.com: automatic fallback when Resend is out of quota or down (free 300/day). The sender EMAIL_FROM address/domain must be verified in Brevo
WHATSAPP_TOKEN=              # optional: WhatsApp Cloud API token for customer order updates
WHATSAPP_PHONE_ID=           # WhatsApp phone number ID from Meta
WA_TEMPLATE_PAID=order_confirmed   # approved template name (3 variables: name, reference, total)
WA_TEMPLATE_SHIPPED=order_shipped  # approved template name (3 variables: name, reference, carrier)
WHATSAPP_LANG=en
TERMII_API_KEY=              # optional: SMS provider for phone login (only used when the Phone login switch is ON)
TERMII_SENDER_ID=HouseOfQG      # sender ID registered with Termii
TERMII_CHANNEL=generic       # generic or dnd; check Termii's current docs
EMAIL_REPLY_TO=              # optional: where customer replies go (defaults to OWNER_EMAIL)
GOOGLE_SITE_VERIFICATION=    # Google Search Console > HTML tag method: paste only the content="..." value
BING_SITE_VERIFICATION=      # optional: Bing Webmaster Tools msvalidate.01 value
META_DOMAIN_VERIFICATION=    # Meta Business Suite > Brand safety > Domains: facebook-domain-verification value (needed for Instagram/Facebook Shops)
FLUTTERWAVE_FORWARDS=        # optional: pass other companies payments on, e.g. runserv_=https://runserv.org/api/webhook,store_=https://elorgestore.org/api/webhook (prefix of their tx_ref = their URL)
